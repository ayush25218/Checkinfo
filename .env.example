MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=checkinfo

AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=change-this-admin-password
MEMBER_LOGIN_USERNAME=member
MEMBER_LOGIN_PASSWORD=change-this-member-password

# Optional external search integration.
GOOGLE_MAPS_API_KEY=

# Google sign-in for business/member login.
# Add the OAuth Client ID and Client Secret from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
